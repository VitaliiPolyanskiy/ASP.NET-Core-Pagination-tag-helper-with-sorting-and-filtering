@model IEnumerable<Soccer.Models.Team>

@{
    ViewData["Title"] = "Команди";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Список команд</h2>

<p>
    <a asp-action="Create" class="btn btn-success">+ Додати нову команду</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Coach)
                </th>
                <th class="text-end">Дії</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Coach)
                </td>
                    <td class="text-end">
                        <!-- Прибрано клас btn-group-sm для нормального розміру кнопок -->
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Редагувати">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Деталі">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Видалити">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
            </tr>
        }
        </tbody>
    </table>
</div>